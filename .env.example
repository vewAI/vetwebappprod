# Example environment variables (DO NOT commit real secrets)
# Copy this to `.env.local` and fill with real values for local development.

# Public Supabase values (safe for client use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key-placeholder

# Service role key: SERVER ONLY — do NOT expose to client or commit
SUPABASE_SERVICE_ROLE_KEY=service-role-key-placeholder

# OpenAI API key: SERVER ONLY
OPENAI_API_KEY=sk-xxxx-your-openai-key-xxxx

# Gemini Live: SERVER ONLY — never exposed to the client.
# /api/live/token issues short-lived ephemeral tokens from this key.
GEMINI_API_KEY=your-gemini-api-key

# Live token safety: set to "1" in production to fail closed (503) if
# ephemeral token issuance fails instead of falling back to the raw key.
# LIVE_REQUIRE_EPHEMERAL_TOKENS=1

# Live origin allowlist for /api/live/token (comma separated). In production
# this defaults to NEXT_PUBLIC_APP_URL or VERCEL_URL; strict-deny if unset.
# LIVE_ALLOWED_ORIGINS=https://your-domain.com

# Redis: SERVER ONLY — enables authoritative rate limiting and the TTS store
# across serverless instances (falls back to in-memory per-process if unset).
# REDIS_URL=rediss://default:password@host:port

# Persona image model (config)
PERSONA_IMAGE_MODEL=dall-e-3

# WebAuthn / Passkey (optional; defaults work for localhost)
# WEBAUTHN_RELYING_PARTY_ID=localhost
# WEBAUTHN_RELYING_PARTY_NAME=VewAI Veterinary OSCE
# WEBAUTHN_RELYING_PARTY_ORIGIN=http://localhost:3000

# Notes:
# - This file is only a template. Never commit real secret keys.
# - Keep `.env.local` in your local `.gitignore` and use secret storage for deployment.